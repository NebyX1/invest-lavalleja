{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "jobkler-ai",
    "backend",
    "invest-lavalleja-backend-current",
    "invest-lavalleja-frontend-current",
    "sample-backend",
    "better-rag",
    "test-results"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": false,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true
  }
}
