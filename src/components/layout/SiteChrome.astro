<script>
  const globalKey = '__investLavallejaChrome';
  const chromeWindow = window as Window & { __investLavallejaChrome?: AbortController };
  const setup = () => {
    chromeWindow[globalKey]?.abort?.();
    const controller = new AbortController();
    chromeWindow[globalKey] = controller;
    const signal = controller.signal;
    const openSearch = (event?: Event) => {
      const trigger = event?.target instanceof Element ? event.target.closest('[data-open-search]') : null;
      if (event && !trigger) return;
      event?.preventDefault();
      (window as Window & { __investSearchPending?: boolean }).__investSearchPending = true;
      window.dispatchEvent(new CustomEvent('invest:open-search'));
    };
    const onKeyDown = (event: KeyboardEvent) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') openSearch(event);
    };
    document.addEventListener('click', openSearch, { signal, capture: true });
    document.addEventListener('keydown', onKeyDown, { signal });
    const menuButton = document.querySelector('[data-menu-toggle]');
    const nav = document.querySelector('[data-mobile-nav]');
    const closeMenu = () => {
      if (!menuButton || !nav) return;
      menuButton.setAttribute('aria-expanded', 'false');
      menuButton.setAttribute('aria-label', 'Abrir menú');
      nav.classList.remove('is-open');
    };
    menuButton?.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isOpen));
      menuButton.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
      nav?.classList.toggle('is-open', !isOpen);
    }, { signal });
    nav?.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) closeMenu();
    }, { signal });
    document.addEventListener('astro:before-preparation', closeMenu, { signal });
    document.addEventListener('astro:page-load', closeMenu, { signal });
  };

  if (!chromeWindow[globalKey]) {
    setup();
    document.addEventListener('astro:page-load', setup, { once: false });
  }
</script>
