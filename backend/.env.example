# Generate the secrets with: python scripts/setup_env.py
APP_ENV=production
SECRET_KEY=
ENCRYPTION_KEY=
DATA_DIR=/app/data
# Backend domain(s), without scheme. Keep 127.0.0.1 for the private container health check.
TRUSTED_HOSTS=gianna.ejemplo.uy,127.0.0.1,localhost
# Exact allowed front-end origins, no paths and no wildcards.
PUBLIC_ORIGINS=https://invest.ejemplo.uy,https://gianna.ejemplo.uy
# Only behind Coolify's trusted reverse proxy, with no direct public port on the API.
PROXY_HOPS=1

OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
# Confirm availability in the Ollama Cloud catalogue before deployment.
OLLAMA_MODEL=deepseek-v4.1-flash

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# main downloads the current export on first run; the exact revision and file hash are recorded.
# Pin to that immutable revision for reproducible rebuilds before production.
E5_REVISION=main
E5_MODEL_FILE=onnx/model.onnx
EMBEDDING_THREADS=2
EMBEDDING_BATCH_SIZE=8
MAX_CONCURRENT_CHAT=3
WORKER_ENABLED=true
MAX_UPLOAD_MB=12
MAX_RECORDS=10000
# Limit numerical libraries as well as the ONNX runtime.
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false

# Optional: code-by-email second factor. TOTP does not need SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_MODE=starttls
