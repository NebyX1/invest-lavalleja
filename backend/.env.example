# Flask: production en Coolify; development para uso local.
FLASK_ENV=production
# Generar con python scripts/setup_env.py. Conservar ambas claves entre despliegues.
SECRET_KEY=
ENCRYPTION_KEY=

# Base MariaDB dedicada a Gianna; nunca reutilizar el esquema de otra aplicación.
DATABASE_URL=mariadb+mariadbconnector://gianna_user:password@db-host:3306/gianna_invest
# Solo para compose.human-test.yaml: esquema vacío e independiente.
DATABASE_URL_HUMAN_TEST=mariadb+mariadbconnector://gianna_user:password@host.docker.internal:3306/gianna_invest_human_test

# Orígenes HTTPS exactos, separados por coma. Incluir la API si usa otro dominio.
CORS_ORIGINS=https://invest.lavalleja.uy

# Ollama Cloud. Usar el identificador del catálogo del proveedor.
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4.1-flash

# Correo para el segundo factor. TOTP no necesita servidor de correo.
MAIL_SERVER=
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
